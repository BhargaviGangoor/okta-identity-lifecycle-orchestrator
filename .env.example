# ==============================================================================
# TEAM ECHO — OKTA IDENTITY LIFECYCLE ORCHESTRATOR
# Example Environment Configuration (.env.example)
# Copy this file to .env for local development
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
API_CONTEXT_PATH=/api

# Database Configuration (H2 in-memory by default)
DB_URL=jdbc:h2:mem:identity_orchestrator;DB_CLOSE_DELAY=-1;MODE=MySQL
DB_USERNAME=sa
DB_PASSWORD=

# Okta Tenant Integration Credentials
OKTA_DOMAIN=https://dev-example.okta.com
OKTA_API_TOKEN=your_okta_api_token_here
OKTA_CLIENT_ID=your_okta_client_id_here
OKTA_CLIENT_SECRET=your_okta_client_secret_here

# Frontend Application Configuration
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api
